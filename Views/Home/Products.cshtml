@model List<BaiTapBuoi5.Models.Product>

<h1>Danh sách sản phẩm</h1>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Id</th>
            <th>Tên sản phẩm</th>
            <th>Giá</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in Model)
        {
            <tr>
                <td>@product.Id</td>
                <td>@product.Name</td>
                <td>@product.Price.ToString("N0") đ</td>
            </tr>
        }
    </tbody>
</table>